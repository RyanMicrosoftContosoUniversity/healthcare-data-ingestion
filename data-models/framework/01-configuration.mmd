    ProcessingDomain {
        bigint DomainID PK
        nvarchar(64) DomainName
        varchar(8) DefaultLoggingLevel
        bit DefaultProfileTransformations
    }

    SourceSystem {
        smallint SourceSystemID PK
        varchar(30) SourceSystemName
        nvarchar(256) ConnectionRef
    }

    SourceObject {
        bigint SourceObjectID PK
        smallint SourceSystemID FK
