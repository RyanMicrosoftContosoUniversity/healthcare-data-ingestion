    PipelineDefinition {
        uniqueidentifier PipelineID PK
        bigint DomainID FK
        nvarchar(128) PipelineName
        varchar(16) InputLayer
        varchar(16) OutputLayer
        varchar(8) LoggingLevel "NULL"
    }

    PipelineObject {
        bigint PipelineObjectID PK
        uniqueidentifier PipelineID FK
        bigint SourceObjectID FK
        nvarchar(128) TargetSchema
        nvarchar(128) TargetTable
        varchar(24) LoadStrategy
    }

    TransformationStep {
        bigint TransformationStepID PK
        bigint PipelineObjectID FK
        int StepOrdinal
        nvarchar(128) RegistryFunctionName
    }

