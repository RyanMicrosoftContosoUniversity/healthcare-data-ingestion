        uniqueidentifier RunID FK
        uniqueidentifier TableRunID FK
    }

    IngestionTransformationRun {
        uniqueidentifier StepExecutionID PK
        uniqueidentifier RunID FK
        uniqueidentifier TableRunID FK
        bigint TransformationStepID FK
    }

    SparkApplicationRunMetric {
        uniqueidentifier SparkMetricID PK
        uniqueidentifier RunID FK
        uniqueidentifier TableRunID FK "NULL"
    }

    DiagnosticCollection {
        uniqueidentifier CollectionID PK
        uniqueidentifier RunID FK
        uniqueidentifier SparkMetricID FK "NULL"
    }

    DiagnosticArtifact {
        uniqueidentifier ArtifactID PK
        uniqueidentifier CollectionID FK
    }

    AlertEvent {
        uniqueidentifier AlertEventID PK
        uniqueidentifier PipelineID FK "NULL"
        uniqueidentifier RunID FK "NULL"
        uniqueidentifier TableRunID FK "NULL"
        uniqueidentifier SparkMetricID FK "NULL"
    }

