        uniqueidentifier LeaseOwnerRunID FK "NULL"
    }

    IngestionError {
        uniqueidentifier ErrorID PK
        uniqueidentifier RunID FK
        uniqueidentifier TableRunID FK "NULL"
        uniqueidentifier StepExecutionID FK "NULL"
    }

    SchemaChangeLog {
        uniqueidentifier SchemaChangeID PK
        uniqueidentifier RunID FK
        uniqueidentifier TableRunID FK
    }

