%% PROPOSED FOR REVIEW - synthetic schemas, not proprietary Epic definitions.
%% NOT NULL unless a column comment starts with NULL.
%% PK = primary key; FK = foreign key; UK = single-column unique key.
%% Dashed edges are non-identifying; endpoint symbols indicate optionality.
%% Shared audit columns are omitted; see shared\01-audit-columns.mmd.
%% Full business columns: FactEncounter.
%% Context tables (keys/identifiers only): DimPatient, DimDepartment, DimProvider, DimCoverage, DimDate.
%% One encounter; accumulating snapshot. Lookup time: ArrivalAtUtc.
%% Unique event identity: OriginSystem plus this fact table's source event ID.
%% Source IDs are lineage only: no cross-database or fact-to-fact foreign keys.
%% Repeated date relationships represent roles of the same physical DimDate.
%% Every displayed table retains all declared FK columns, including off-diagram targets.
erDiagram
    direction LR
    FactEncounter {
        bigint EncounterKey PK
        bigint SourceEncounterID
        varchar(40) EncounterNumber
        bigint PatientKey FK
        bigint DepartmentKey FK
        bigint AttendingProviderKey FK "NULL"
        bigint CoverageKey FK "NULL"
        int ArrivalDateKey FK
        int DischargeDateKey FK "NULL"
        datetime2(7) ArrivalAtUtc
        datetime2(7) DischargeAtUtc "NULL"
        varchar(30) EncounterTypeCode
        varchar(20) EncounterStatus
        varchar(30) DischargeDispositionCode "NULL"
        decimal LengthOfStayMinutes "NULL; decimal(18,2)"
        int EncounterCount
        varchar(30) OriginSystem "Business-key scope"
    }

    DimPatient {
        bigint PatientKey PK
        varchar(30) MedicalRecordNumber
        varchar(30) OriginSystem "Business-key scope"
    }

    DimDepartment {
        bigint DepartmentKey PK
        varchar(30) DepartmentCode
        varchar(30) OriginSystem "Business-key scope"
    }

    DimProvider {
        bigint ProviderKey PK
        varchar(30) ProviderCode
        varchar(30) OriginSystem "Business-key scope"
    }

    DimCoverage {
        bigint CoverageKey PK
        varchar(40) CoverageNumber
        varchar(30) OriginSystem "Business-key scope"
    }

    DimDate {
        int DateKey PK
        date CalendarDate UK
    }

    DimPatient ||..o{ FactEncounter : PatientKey
    DimDepartment ||..o{ FactEncounter : DepartmentKey
    DimProvider |o..o{ FactEncounter : AttendingProviderKey
    DimCoverage |o..o{ FactEncounter : CoverageKey
    DimDate ||..o{ FactEncounter : ArrivalDateKey
    DimDate |o..o{ FactEncounter : DischargeDateKey
