%% PROPOSED FOR REVIEW - synthetic schemas, not proprietary Epic definitions.
%% NOT NULL unless a column comment starts with NULL.
%% PK = primary key; FK = foreign key; UK = single-column unique key.
%% Dashed edges are non-identifying; endpoint symbols indicate optionality.
%% Shared audit columns are omitted; see shared\01-audit-columns.mmd.
%% Full business columns: FactAppointment.
%% Context tables (keys/identifiers only): DimPatient, DimDepartment, DimProvider, DimDate.
%% One appointment, including unlinked appointments. Lookup time: ScheduledStartAtUtc.
%% Unique event identity: OriginSystem plus this fact table's source event ID.
%% Source IDs are lineage only: no cross-database or fact-to-fact foreign keys.
%% Repeated date relationships represent roles of the same physical DimDate.
%% Every displayed table retains all declared FK columns, including off-diagram targets.
erDiagram
    direction LR
    FactAppointment {
        bigint AppointmentKey PK
        bigint SourceAppointmentID
        bigint SourceEncounterID "NULL"
        varchar(40) AppointmentNumber
        bigint PatientKey FK
        bigint DepartmentKey FK
        bigint ProviderKey FK "NULL"
        int ScheduledDateKey FK
        datetime2(7) ScheduledStartAtUtc
        datetime2(7) ScheduledEndAtUtc
        varchar(30) AppointmentTypeCode
        varchar(20) AppointmentStatus
        datetime2(7) CanceledAtUtc "NULL"
        decimal ScheduledDurationMinutes "decimal(18,2)"
        int AppointmentCount
        varchar(30) OriginSystem "Business-key scope"
    }

    DimPatient {
        bigint PatientKey PK
        varchar(30) MedicalRecordNumber
        varchar(30) OriginSystem "Business-key scope"
    }

    DimDepartment {
        bigint DepartmentKey PK
        varchar(30) DepartmentCode
        varchar(30) OriginSystem "Business-key scope"
    }

    DimProvider {
        bigint ProviderKey PK
        varchar(30) ProviderCode
        varchar(30) OriginSystem "Business-key scope"
    }

    DimDate {
        int DateKey PK
        date CalendarDate UK
    }

    DimPatient ||..o{ FactAppointment : PatientKey
    DimDepartment ||..o{ FactAppointment : DepartmentKey
    DimProvider |o..o{ FactAppointment : ProviderKey
    DimDate ||..o{ FactAppointment : ScheduledDateKey
